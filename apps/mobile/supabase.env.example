# Supabase 客户端连接参数。复制本文件为 supabase.env 后填入真实值。
# supabase.env 已被 .gitignore 排除，禁止提交。
#
# 注入方式（与 amap.env 不同，两端一致）：
#   这两个值由 Dart 侧 String.fromEnvironment 读取（见
#   lib/app/config/supabase_config.dart），Android 与 iOS 都没有原生兜底机制，
#   因此任何构建都必须显式附加：
#     --dart-define-from-file=supabase.env
#   若同时需要高德 Key，两个文件一起传：
#     flutter run --dart-define-from-file=supabase.env \
#                 --dart-define-from-file=amap.env
#
# 自建实例地址。当前服务端仅提供 HTTP，尚未配置 HTTPS，因此：
#   Android  必须在 AndroidManifest 声明 android:usesCleartextTraffic="true"，
#            否则系统直接拦截请求，报错易被误判为服务端故障。
#   iOS      需配置 ATS 例外。
# 配好域名与 HTTPS 后改为 https:// 即可免去上述两项平台配置。
SUPABASE_URL=

# 匿名公钥。设计上可随客户端分发：它只代表「未认证访客」身份，真正的数据边界
# 由 RLS 策略与用户登录后签发的 JWT 保证。
#
# 严禁在此填入 SERVICE_ROLE_KEY——该 key 绕过全部 RLS，一旦随客户端分发，
# 等同于把整个数据库公开。服务端 /opt/savorseek/.env 里的其余密钥
# （POSTGRES_PASSWORD、JWT_SECRET、SECRET_KEY_BASE 等）同样不得进入客户端。
SUPABASE_ANON_KEY=
